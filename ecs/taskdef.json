{
  "family": "photo-uploader-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::047719661196:role/photo-uploader-task-execution-role",
  "taskRoleArn": "arn:aws:iam::047719661196:role/photo-uploader-task-role",
  "containerDefinitions": [
    {
      "name": "photo-uploader-container",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_OWNER_NAME", "value": "David Muhire" },
        { "name": "LAB_NAME", "value": "Photo Uploader Lab V3" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "PHOTOS_BUCKET_NAME", "value": "photo-uploader-photos-047719661196-us-east-1" },
        { "name": "CLOUDFRONT_DOMAIN", "value": "d1xjbqq5utb6bp.cloudfront.net" },
        { "name": "DB_HOST", "value": "photo-uploader-databasestack-rzj0zgtmnpxv-database-qxr1vzoocbpd.c29usw4u0jid.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "photogallery" }
      ],
      "secrets": [
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:secretsmanager:us-east-1:047719661196:secret:rds!db-ad3e60a0-432f-4c96-9406-204f9f66fcaf-pnV4KI:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:047719661196:secret:rds!db-ad3e60a0-432f-4c96-9406-204f9f66fcaf-pnV4KI:password::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/photo-uploader-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
