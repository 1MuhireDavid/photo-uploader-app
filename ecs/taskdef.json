{
  "family": "photo-uploader-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::047719661196:role/photo-uploader-task-execution-role",
  "taskRoleArn": "arn:aws:iam::047719661196:role/photo-uploader-task-role",
  "containerDefinitions": [
    {
      "name": "photo-uploader-container",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_OWNER_NAME", "value": "David Muhire" },
        { "name": "LAB_NAME", "value": "Photo Uploader Lab V3" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "PHOTOS_BUCKET_NAME", "value": "photo-uploader-photos-047719661196-us-east-1" },
        { "name": "CLOUDFRONT_DOMAIN", "value": "d1xjbqq5utb6bp.cloudfront.net" },
        { "name": "DB_HOST", "value": "<DB_HOST>" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_NAME", "value": "photogallery" }
      ],
      "secrets": [
        { "name": "DB_USERNAME", "valueFrom": "<DB_SECRET_ARN>:username::" },
        { "name": "DB_PASSWORD", "valueFrom": "<DB_SECRET_ARN>:password::" }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "(exec 3<>/dev/tcp/127.0.0.1/8080) || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/photo-uploader-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
